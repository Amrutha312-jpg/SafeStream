// Paste these into your app-level build.gradle.kts (module :app), inside dependencies { }
// and inside android { } as noted.

/* ---- inside android { } ---- */
// aaptOptions / androidResources: don't compress the model file
androidResources {
    noCompress += "tflite"
}

/* ---- inside dependencies { } ---- */
dependencies {
    // CameraX
    val cameraxVersion = "1.3.4"
    implementation("androidx.camera:camera-core:$cameraxVersion")
    implementation("androidx.camera:camera-camera2:$cameraxVersion")
    implementation("androidx.camera:camera-lifecycle:$cameraxVersion")
    implementation("androidx.camera:camera-view:$cameraxVersion")

    // TensorFlow Lite
    implementation("org.tensorflow:tensorflow-lite:2.16.1")
    implementation("org.tensorflow:tensorflow-lite-gpu:2.16.1")
    implementation("org.tensorflow:tensorflow-lite-support:0.4.4")

    // OpenCV -- do NOT use the old Maven "org.opencv:opencv-android" artifact,
    // it's unmaintained. Instead download the official SDK:
    //   https://opencv.org/releases/  -> "Android" package
    // Unzip it, then in Android Studio:
    //   File > New > Import Module... > point at <unzipped>/sdk
    // Then add:
    implementation(project(":opencv"))

    // Standard AndroidX
    implementation("androidx.core:core-ktx:1.13.1")
    implementation("androidx.appcompat:appcompat:1.7.0")
    implementation("com.google.android.material:material:1.12.0")
    implementation("androidx.constraintlayout:constraintlayout:2.1.4")
}
